{
  "name": "ekkhu",
  "version": "1.0.0",
  "description": "EKKHU - Academic OS. Offline-first desktop app for students (routine, attendance, budget, CGPA, tasks, AI tutor).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "EKKHU",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ekkhu.academicos",
    "productName": "EKKHU",
    "files": [
      "main.js",
      "preload.js",
      "app.py",
      "requirements.txt",
      "templates/**/*",
      "static/**/*"
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
